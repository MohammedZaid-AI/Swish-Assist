# Groq (https://console.groq.com/keys). Without a key the demo runs in offline mode.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_FALLBACK_MODEL=openai/gpt-oss-20b
# The spec named qwen/qwen3.6-27b; on the tested Groq account only qwen/qwen3.8-27b was available.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Supabase (optional). Leave empty to use the local SQLite file at data/swish.db.
SUPABASE_URL=
SUPABASE_KEY=

# Twilio WhatsApp sandbox (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Decision rules
AUTO_REFUND_MAX_INR=300
AUTO_REFUND_MIN_CONFIDENCE=0.8

# Public URL of this server (used for Twilio signature validation), e.g. https://swish-assist.onrender.com
PUBLIC_BASE_URL=
# Shown in the landing page footer
GITHUB_URL=https://github.com/

# Keep-alive (Render free plan sleeps after ~15 min idle). On Render this defaults to 10 minutes and
# uses RENDER_EXTERNAL_URL automatically; locally it is off. 0 turns it off.
KEEP_ALIVE_MINUTES=
KEEP_ALIVE_URL=
